auto-update = off
window-decoration = true
window-theme = dark
macos-window-buttons = hidden
window-save-state = never
window-padding-balance = true
maximize = true
confirm-close-surface = false
macos-option-as-alt = true
shell-integration = zsh
shell-integration-features = no-cursor,title
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
clipboard-read = allow
clipboard-paste-protection = false
window-inherit-working-directory = true

font-family = JetBrainsMono Nerd Font Mono
font-size = 13

# Nerd Font codepoints (fallback for symbols)
font-codepoint-map = U+e0b0-U+e0b3,U+e0b4-U+e0c8,U+e0cc-U+e0d4,U+e0ca=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+f000-U+f2e0,U+e200-U+e2a9=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+e5fa-U+e6b1=JetBrainsMono Nerd Font Mono
font-codepoint-map = U+ea60-U+ebeb=JetBrainsMono Nerd Font Mono

theme = catppuccin-mocha
background = #000000

# tmux owns tabs, splits and navigation: drop every default binding
# and re-add only the essentials.
keybind = clear
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+n=new_window
keybind = super+t=new_window
keybind = super+w=close_window
keybind = super+q=quit
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
keybind = super+comma=open_config
keybind = super+shift+comma=reload_config
