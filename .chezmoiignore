**/*CLAUDE.md
.devenv
.devenv/**
.direnv
.direnv/**
.editorconfig
devenv.lock
devenv.yaml
.claude
.claude/**

# Test files (not dotfiles)
.scripts/tests
.scripts/tests/**
.local/bin/tests
.local/bin/tests/**
private_dot_local/bin/tests
private_dot_local/bin/tests/**

# Environment files with secrets (loaded by direnv/devenv)
.env.local
.env.work

# Machine-specific zsh environment (not tracked)
.config/zsh/.zshenv.local

# OS-specific scripts (ignore scripts for other operating systems)
{{ if ne .chezmoi.os "darwin" }}
.chezmoiscripts/darwin-*
{{ end }}

{{ if ne .chezmoi.os "windows" }}
.chezmoiscripts/windows-*
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.chezmoiscripts/linux-*
{{ end }}

# Unix-only configurations (ignore on Windows)
{{ if eq .chezmoi.os "windows" }}
.config/zim
.config/zim/**
.config/tmux
.config/tmux/**
.config/zsh
.config/zsh/**
.config/tridactyl
.config/tridactyl/**
.config/systemd
.config/systemd/**
{{ end }}

# Alacritty is Windows-only (no Ghostty build for Windows)
{{ if ne .chezmoi.os "windows" }}
.config/alacritty
.config/alacritty/**
{{ end }}

# macOS-only configurations (ignore on non-macOS)
{{ if ne .chezmoi.os "darwin" }}
nix/darwin
nix/darwin/**
{{ end }}

# Desktop-specific (ignore on headless/server machines)
{{ if not .machineConfig.features.desktop }}
.config/ghostty
.config/ghostty/**
.config/tridactyl
.config/tridactyl/**
.config/hammerspoon
.config/hammerspoon/**
{{ end }}

# Platform variable
{{ $platform := "" }}
{{ if hasKey .machineConfig "platform" }}{{ $platform = .machineConfig.platform }}{{ end }}

# Ephemeral Linux (no Bitwarden): SSH handled externally
{{ if eq $platform "linux-apt" }}
.ssh
.ssh/**
{{ end }}

# Kube config symlink only for WSL (symlinks to Windows host config)
{{ if not (and (eq .chezmoi.os "linux") (env "WSL_DISTRO_NAME")) }}
.kube/config
{{ end }}

# linux-apt platform only
{{ if ne $platform "linux-apt" }}
.config/environment.d
.config/environment.d/**
{{ end }}

# darwin-specific
{{ if ne .chezmoi.os "darwin" }}
.config/hammerspoon
.config/hammerspoon/**
{{ end }}

# User-managed directory contents (keep directory structure, ignore contents)
.kube/**
!.kube/.keep

# WSL-only scripts
{{ if not (and (eq .chezmoi.os "linux") (env "WSL_DISTRO_NAME")) }}
.chezmoiscripts/*wsl-kube-config-warning*
{{ end }}
