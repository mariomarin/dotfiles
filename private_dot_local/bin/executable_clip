#!/usr/bin/env -S nu --stdin

# Copy stdin or file to clipboard (platform-aware, SSH-aware)
# Usage: echo "text" | clip
#        clip file.txt
#        clip "some text"
#        cmd | clip --haste   # upload to $HASTE_SERVER, copy the URL
#
# SSH detection: layers SSH_TTY, SSH_CONNECTION, and SSH_CLIENT to cover
# interactive shells, non-TTY sessions, and older SSH implementations.
# This is correct when tmux is always started from the same context it's
# used in (SSH→SSH, local→local). If tmux was started locally and you
# attach over SSH, none of these will be set — which is the right behavior.
#
# Input is handled as bytes end to end. nu types stdin by sniffing it (valid
# UTF-8 → string, anything else → binary) and `decode utf-8` is lossy, so
# decoding would corrupt non-UTF-8 input. Clipboard tools take bytes anyway.

use adt.nu [ok, err, run-cmd, "result map", "result flat-map", "result bimap"]

const CLIPPER_PORT = 8377

def select-backend [env_flags: record<ssh: bool, macos: bool, wsl: bool, has_xclip: bool, has_wl_copy: bool>]: nothing -> string {
    if $env_flags.ssh { return "ssh" }
    if $env_flags.macos { return "pbcopy" }
    if $env_flags.wsl { return "clip.exe" }
    if $env_flags.has_xclip { return "xclip" }
    if $env_flags.has_wl_copy { return "wl-copy" }
    "none"
}

# Command line for a backend. pbcopy decodes stdin using the locale and falls
# back to MacRoman without one (launchd, tmux run-shell), so pin it to UTF-8.
def backend-argv [backend: string]: nothing -> record {
    match $backend {
        "ssh"      => (ok [nc -N localhost ($CLIPPER_PORT | into string)])
        "pbcopy"   => (ok [env LC_CTYPE=UTF-8 pbcopy])
        "clip.exe" => (ok [clip.exe])
        "xclip"    => (ok [xclip -selection clipboard])
        "wl-copy"  => (ok [wl-copy])
        _          => (err "no clipboard backend found (pbcopy, clip.exe, xclip, wl-copy)")
    }
}

def is-ssh []: nothing -> bool {
    [SSH_TTY SSH_CONNECTION SSH_CLIENT]
    | any {|key| ($env | get --optional $key | is-not-empty) }
}

def is-macos []: nothing -> bool {
    (^uname | str trim) == "Darwin"
}

def is-wsl []: nothing -> bool {
    "/proc/sys/fs/binfmt_misc/WSLInterop" | path exists
}

def has-cmd [cmd: string]: nothing -> bool {
    (which $cmd | is-not-empty)
}

# Normalize any input to bytes: strings become their UTF-8 encoding, binary
# passes through untouched, nothing becomes empty.
def to-bytes []: any -> binary {
    match $in {
        null => 0x[]
        $input => ($input | into binary)
    }
}

def read-file [path: string]: nothing -> record {
    match ($path | path exists) {
        true => (ok (open --raw $path | to-bytes))
        false => (err $"file not found: ($path)")
    }
}

def require-bytes []: binary -> record {
    match $in {
        $b if ($b | is-empty) => (err "no input provided (stdin was empty and no args given)")
        $b => (ok $b)
    }
}

# Bytes from args: first arg as a file if it exists, else args as text
def read-args [args: list<string>]: nothing -> record {
    match $args {
        [$path, ..] if ($path | path exists) => (read-file $path)
        _ => (ok ($args | str join " " | to-bytes))
    }
}

def resolve-backend []: nothing -> string {
    select-backend {
        ssh: (is-ssh)
        macos: (is-macos)
        wsl: (is-wsl)
        has_xclip: (has-cmd "xclip")
        has_wl_copy: (has-cmd "wl-copy")
    }
}

# Human-readable message for a failed run-cmd
def describe-failure [cmd: string, failure: record]: nothing -> string {
    let hint = match $cmd {
        "nc" => $" — clipper may not be running or port ($CLIPPER_PORT) is not forwarded"
        _ => ""
    }
    let detail = match ($failure.stderr | str trim) {
        "" => ""
        $stderr => $": ($stderr)"
    }
    $"($cmd) exited with code ($failure.code)($hint)($detail)"
}

# Pipe bytes into argv, reporting failures as a message
def copy-bytes [bytes: binary, argv: list<string>]: nothing -> record {
    match $argv {
        [$cmd, ..] if not (has-cmd $cmd) => (err $"($cmd) not found in PATH")
        [$cmd, ..$rest] => {
            match (run-cmd { $bytes | ^$cmd ...$rest }) {
                {ok: true} => (ok null)
                {error: $failure} => (err (describe-failure $cmd $failure))
            }
        }
    }
}

# --- Haste (Hastebin-compatible paste server) ---

def normalize-url [raw: string]: nothing -> string {
    match ($raw | str trim | str replace -r '/$' '') {
        $url if ($url =~ '^https?://') => $url
        $host => $"https://($host)"
    }
}

def haste-server []: nothing -> record {
    match ($env.HASTE_SERVER? | default "" | str trim) {
        "" => (err "HASTE_SERVER not set")
        $server => (ok (normalize-url $server))
    }
}

def parse-haste-response [body: string]: nothing -> record {
    let trimmed = ($body | str trim)
    if ($trimmed | is-empty) { return (err "empty response") }
    match (try { $trimmed | from json } catch { null }) {
        {key: $key} if ($key | is-not-empty) => (ok $key)
        $doc if ($doc | describe | str starts-with "record") => (err $"no key in response: ($trimmed)")
        # from json is lenient (bare words parse as strings): non-records are invalid
        _ => (err $"invalid JSON: ($trimmed)")
    }
}

def build-paste-url [server: string, key: string, ext: string]: nothing -> string {
    match $ext {
        "" => $"($server)/($key)"
        _ => $"($server)/($key).($ext)"
    }
}

# Paste servers store text: decode (lossily) and drop terminal colors
def haste-text []: binary -> string {
    decode utf-8 | ansi strip
}

# Syntax highlighting extension: from the file being pasted, if any
def paste-ext [args: list<string>]: nothing -> string {
    match $args {
        [$path, ..] if ($path | path exists) => ($path | path parse | get extension)
        _ => ""
    }
}

def upload-haste [server: string, bytes: binary, ext: string]: nothing -> record {
    if not (has-cmd curl) { return (err "curl not found in PATH") }
    let text = ($bytes | haste-text)
    run-cmd { $text | ^curl -sS -X POST --data-binary @- $"($server)/documents" }
    | result bimap {|out| $out.stdout } {|failure| describe-failure curl $failure }
    | result flat-map {|body| parse-haste-response $body }
    | result map {|key| build-paste-url $server $key $ext }
}

# Clipboard payload: the input itself, or with --haste the URL it was pasted to
def payload [bytes: binary, haste: bool, ext: string]: nothing -> record {
    match $haste {
        false => (ok {bytes: $bytes, url: null})
        true => (haste-server
            | result flat-map {|server| upload-haste $server $bytes $ext }
            | result map {|url| {bytes: ($url | to-bytes), url: $url} })
    }
}

export def main [
    --verbose (-v)  # Print the backend being used
    --haste (-H)    # Upload to $HASTE_SERVER and copy the paste URL instead
    --ext (-e): string # Haste syntax extension (default: the file's extension)
    ...args: string # File path or literal text; omit to read stdin
] {
    let backend = resolve-backend
    if $verbose { print $"clip: using ($backend)" }

    # Read stdin only without args: otherwise a piped-but-open stdin blocks.
    # An `if`, not `match`: `$in` in a match arm hits a nu 0.115 IR bug.
    let input = if ($args | is-empty) { ok ($in | to-bytes) } else { read-args $args }
    let ext = ($ext | default (paste-ext $args))
    let job = match ($input
        | result flat-map {|bytes| $bytes | require-bytes }
        | result flat-map {|bytes| payload $bytes $haste $ext }) {
        {ok: true, value: $job} => $job
        {error: $message} => (error make --unspanned { msg: $"clip: ($message)" })
    }

    # Print the URL first: it is the result even if no clipboard is available
    if $job.url != null { print $job.url }

    match (backend-argv $backend | result flat-map {|argv| copy-bytes $job.bytes $argv }) {
        {ok: true} => null
        {error: $message} if $haste => (print -e $"clip: warning: URL not copied: ($message)")
        {error: $message} => (error make --unspanned { msg: $"clip: ($message)" })
    }
}
