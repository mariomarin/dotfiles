# NixOS rebuild commands for multi-machine setup

set shell := ["nu", "-c"]

# Default target
default:
    @just switch

# Auto-detect hostname or use HOST environment variable
HOST := env_var_or_default("HOST", `hostname`)

# First-time NixOS setup (use this after fresh NixOS install)
first-time:
    nu nixos.nu first-time {{ HOST }}

# Local build and switch commands
switch:
    sudo nixos-rebuild switch --flake .#{{ HOST }}

test:
    sudo nixos-rebuild test --flake .#{{ HOST }}

boot:
    sudo nixos-rebuild boot --flake .#{{ HOST }}

build:
    sudo nixos-rebuild build --flake .#{{ HOST }}

# Flake management
update:
    nix flake update

check:
    nix flake check

show:
    nix flake show

# Show available hosts
hosts:
    nu nixos.nu hosts {{ HOST }}

# Doctor: report only problems
doctor:
    nu nixos.nu doctor {{ HOST }}

# Linux-apt (ribosome) - install packages via nix profile
linux-apt:
    nu nixos.nu linux-apt ribosome

# Help target
help:
    @echo "NixOS targets (HOST defaults to hostname)"
    @echo "  just switch | test | boot | build"
    @echo "  just hosts | doctor | update | check | show"
