# Work-specific environment variables
# Copy to .env.work and fill in your values
# .env.work is NOT tracked in git

# Hastebin server for paste functions
# Used by `clip --haste` and the haste gem
# Supports both formats: "paste.example.com" or "https://paste.example.com/"
export HASTE_SERVER="https://paste.example.com/"

# Other work-specific secrets can go here
# export WORK_API_TOKEN="..."
